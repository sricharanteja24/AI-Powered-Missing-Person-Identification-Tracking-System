APP_NAME="AI Missing Person Identification & Tracking System"
ENVIRONMENT=development
SECRET_KEY=replace-with-a-secure-64-char-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML Models
YOLO_MODEL=yolo11s.pt
YOLO_CONF_THRESHOLD=0.40
INSIGHTFACE_PACK=buffalo_l
REID_MODEL_NAME=osnet_ain_x1_0
USE_ONNX=true
DEVICE=auto

# Pipeline & Thresholds (Configurable, not calibrated probabilities)
TARGET_SAMPLE_FPS=2.0
MOTION_MIN_AREA_RATIO=0.002
TOP_K_CROPS_PER_TRACK=5
MIN_FACE_SIZE_PX=40
MIN_LAPLACIAN_BLUR=35.0
FACE_MATCH_THRESHOLD=0.45
REID_MATCH_THRESHOLD=0.62
MIN_CONSISTENT_FRAMES=2
